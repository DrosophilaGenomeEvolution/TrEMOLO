#!/usr/bin/env bash
set -euo pipefail

PIPELINE_ROOT="$(cd "$(dirname "$0")" && pwd)"

usage() {
    cat <<'EOF'
Usage:
  module build 1 -i MANIFEST -g REFERENCE_FASTA [-o OUTPUT]
  module build 2 WORK_DIRECTORY [OUTPUT_DIRECTORY] [threshold options]

Both modules now generate self-contained Quarto HTML reports. A persistent
Node server is no longer required.
EOF
}

if [[ $# -lt 2 ]]; then
    usage >&2
    exit 2
fi

COMMAND="$1"
MODULE_NUMBER="$2"
shift 2

if [[ "$COMMAND" == "start" && "$MODULE_NUMBER" == "2" ]]; then
    echo "Module 2 no longer requires a server. Build it and open MODULE_TE_BLAST/report.html." >&2
    usage >&2
    exit 2
fi
if [[ "$COMMAND" != "build" ]]; then
    echo "Unknown command: $COMMAND" >&2
    usage >&2
    exit 2
fi

case "$MODULE_NUMBER" in
    1)
        exec "$PIPELINE_ROOT/modules/1-FREQUENCY-MULTI-GENERATIONS/buildFrequencyGenerations.sh" "$@"
        ;;
    2)
        exec "$PIPELINE_ROOT/modules/2-MODULE_TE_BLAST/server/scripts/buildData.sh" "$@"
        ;;
    *)
        echo "Unknown module: $MODULE_NUMBER" >&2
        usage >&2
        exit 2
        ;;
esac
