"""TrEMOLO refactored workflow (incremental migration)."""

from pathlib import Path
import math
import re


DATA = config.get("DATA", {})
CHOICES = config.get("CHOICE", {}).get("PIPELINE", {})
WORKDIR = DATA.get("WORK_DIRECTORY", "").strip() or "TrEMOLO_OUTPUT"
PIPELINE_ROOT = Path(workflow.basedir).resolve().parent
PREPARE_INPUTS_SCRIPT = PIPELINE_ROOT / "lib/python/workflow/prepare_inputs.py"
THREADS = config.get("PARAMS", {}).get("THREADS", 1)
THREADS = THREADS if isinstance(THREADS, int) and THREADS > 0 else 1
OUTSIDER_PARAMS = config.get("PARAMS", {}).get("OUTSIDER_VARIANT", {})
INSIDER_PARAMS = config.get("PARAMS", {}).get("INSIDER_VARIANT", {})
TE_GENOME_PARAMS = config.get("PARAMS", {}).get("TE_GENOME", {})
if not isinstance(TE_GENOME_PARAMS, dict):
    raise ValueError("PARAMS.TE_GENOME must be a mapping")
INSIDER_SV_CALLER = INSIDER_PARAMS.get("SV_CALLER", "assemblytics")
OUTSIDER_CHOICES = config.get("CHOICE", {}).get("OUTSIDER_VARIANT", {})
INSIDER_CHOICES = config.get("CHOICE", {}).get("INSIDER_VARIANT", {})
INTEGRATE_OUTSIDER_CHOICE = OUTSIDER_CHOICES.get("INTEGRATE_TE_TO_GENOME", False)
TE_GENOME_CHOICE = CHOICES.get("TE_GENOME")
LEGACY_DETECT_ALL_TE = INSIDER_CHOICES.get("DETECT_ALL_TE")
PREPARED_GENOME = f"{WORKDIR}/INPUT/genome.fasta"
PREPARED_REFERENCE = f"{WORKDIR}/INPUT/reference.fasta"
PREPARED_SAMPLE = f"{WORKDIR}/INPUT/reads.fastq"
PREPARED_GENOME_INDEX = PREPARED_GENOME + ".fai"
PREPARED_REFERENCE_INDEX = PREPARED_REFERENCE + ".fai"


def require(name):
    value = DATA.get(name)
    if not value:
        raise ValueError(f"Missing required configuration value: DATA.{name}")
    return value


GENOME = require("GENOME")
TE_DATABASE = require("TE_DB")
REFERENCE = DATA.get("REFERENCE")
SAMPLE = DATA.get("SAMPLE")

if CHOICES.get("INSIDER_VARIANT") and not REFERENCE:
    raise ValueError("DATA.REFERENCE is required when INSIDER_VARIANT is enabled")
if CHOICES.get("OUTSIDER_VARIANT") and not SAMPLE:
    raise ValueError("DATA.SAMPLE is required when OUTSIDER_VARIANT is enabled")
if INSIDER_SV_CALLER != "assemblytics":
    raise ValueError(
        f"INSIDER SV caller '{INSIDER_SV_CALLER}' is not implemented; "
        "available: assemblytics"
    )
if TE_GENOME_CHOICE is not None and type(TE_GENOME_CHOICE) is not bool:
    raise ValueError("CHOICE.PIPELINE.TE_GENOME must be a boolean")
if LEGACY_DETECT_ALL_TE is not None and type(LEGACY_DETECT_ALL_TE) is not bool:
    raise ValueError("CHOICE.INSIDER_VARIANT.DETECT_ALL_TE must be a boolean")
if type(INTEGRATE_OUTSIDER_CHOICE) is not bool:
    raise ValueError(
        "CHOICE.OUTSIDER_VARIANT.INTEGRATE_TE_TO_GENOME must be a boolean"
    )
if (
    TE_GENOME_CHOICE is not None
    and LEGACY_DETECT_ALL_TE is not None
    and TE_GENOME_CHOICE != LEGACY_DETECT_ALL_TE
):
    raise ValueError(
        "CHOICE.PIPELINE.TE_GENOME and legacy "
        "CHOICE.INSIDER_VARIANT.DETECT_ALL_TE disagree"
    )
TE_GENOME_ENABLED = (
    TE_GENOME_CHOICE
    if TE_GENOME_CHOICE is not None
    else bool(LEGACY_DETECT_ALL_TE)
)
OUTSIDER_INTEGRATION_ENABLED = bool(
    INTEGRATE_OUTSIDER_CHOICE and CHOICES.get("OUTSIDER_VARIANT")
)
OUTSIDER_LIFT_ENABLED = (
    OUTSIDER_INTEGRATION_ENABLED and bool(CHOICES.get("INSIDER_VARIANT"))
)
TE_GENOME_TARGETS = TE_GENOME_PARAMS.get("TARGETS", ["GENOME"])
if not isinstance(TE_GENOME_TARGETS, list) or not TE_GENOME_TARGETS:
    raise ValueError("PARAMS.TE_GENOME.TARGETS must be a non-empty list")
if any(type(target) is not str for target in TE_GENOME_TARGETS):
    raise ValueError("PARAMS.TE_GENOME.TARGETS entries must be strings")
TE_GENOME_TARGETS = list(dict.fromkeys(target.upper() for target in TE_GENOME_TARGETS))
if set(TE_GENOME_TARGETS) - {"GENOME", "REFERENCE"}:
    raise ValueError("PARAMS.TE_GENOME.TARGETS supports only GENOME and REFERENCE")
if "REFERENCE" in TE_GENOME_TARGETS and not REFERENCE:
    raise ValueError("DATA.REFERENCE is required for TE_GENOME target REFERENCE")


include: "rules/common.smk"
include: "rules/outsider.smk"
include: "rules/te_database.smk"
include: "rules/outsider_te.smk"
include: "rules/outsider_frequency.smk"
include: "rules/outsider_tsd.smk"
include: "rules/insider.smk"
include: "rules/te_genome.smk"
include: "rules/insider_frequency.smk"
include: "rules/insider_tsd.smk"
include: "rules/outsider_integration.smk"
include: "rules/te_infos.smk"
include: "rules/report.smk"


DEFAULT_TARGETS = [
    f"{WORKDIR}/.inputs.prepared",
    f"{WORKDIR}/input_manifest.json",
    f"{WORKDIR}/INPUT/te_database.fasta",
    f"{WORKDIR}/INPUT/te_headers.tsv",
]
if CHOICES.get("INSIDER_VARIANT") or CHOICES.get("OUTSIDER_VARIANT"):
    DEFAULT_TARGETS.append(TE_INFOS)
    DEFAULT_TARGETS.append(TE_CALL_CANDIDATES)
if TE_GENOME_ENABLED:
    DEFAULT_TARGETS.extend(TE_GENOME_FINAL_OUTPUTS)
    if "GENOME" in TE_GENOME_TARGETS:
        DEFAULT_TARGETS.append(TE_GENOME_PUBLIC_BED)
if OUTSIDER_INTEGRATION_ENABLED:
    DEFAULT_TARGETS.extend(OUTSIDER_INTEGRATION_FINAL_OUTPUTS)
if OUTSIDER_LIFT_ENABLED:
    DEFAULT_TARGETS.extend(OUTSIDER_LIFT_FINAL_OUTPUTS)
if CHOICES.get("REPORT"):
    DEFAULT_TARGETS.append(REPORT_HTML)


rule all:
    input:
        DEFAULT_TARGETS,
