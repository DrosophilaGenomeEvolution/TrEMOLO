"""TrEMOLO refactored workflow (incremental migration)."""

from pathlib import Path
import re


DATA = config.get("DATA", {})
CHOICES = config.get("CHOICE", {}).get("PIPELINE", {})
WORKDIR = DATA.get("WORK_DIRECTORY", "").strip() or "TrEMOLO_OUTPUT"
PIPELINE_ROOT = Path(workflow.basedir).resolve().parent
PREPARE_INPUTS_SCRIPT = PIPELINE_ROOT / "lib/python/workflow/prepare_inputs.py"
THREADS = config.get("PARAMS", {}).get("THREADS", 1)
THREADS = THREADS if isinstance(THREADS, int) and THREADS > 0 else 1
OUTSIDER_PARAMS = config.get("PARAMS", {}).get("OUTSIDER_VARIANT", {})
INSIDER_PARAMS = config.get("PARAMS", {}).get("INSIDER_VARIANT", {})
INSIDER_SV_CALLER = INSIDER_PARAMS.get("SV_CALLER", "assemblytics")
OUTSIDER_CHOICES = config.get("CHOICE", {}).get("OUTSIDER_VARIANT", {})
INSIDER_CHOICES = config.get("CHOICE", {}).get("INSIDER_VARIANT", {})
DETECT_ALL_TE = INSIDER_CHOICES.get("DETECT_ALL_TE", False)
PREPARED_GENOME = f"{WORKDIR}/INPUT/genome.fasta"
PREPARED_REFERENCE = f"{WORKDIR}/INPUT/reference.fasta"
PREPARED_SAMPLE = f"{WORKDIR}/INPUT/reads.fastq"
PREPARED_GENOME_INDEX = PREPARED_GENOME + ".fai"
PREPARED_REFERENCE_INDEX = PREPARED_REFERENCE + ".fai"


def require(name):
    value = DATA.get(name)
    if not value:
        raise ValueError(f"Missing required configuration value: DATA.{name}")
    return value


GENOME = require("GENOME")
TE_DATABASE = require("TE_DB")
REFERENCE = DATA.get("REFERENCE")
SAMPLE = DATA.get("SAMPLE")

if CHOICES.get("INSIDER_VARIANT") and not REFERENCE:
    raise ValueError("DATA.REFERENCE is required when INSIDER_VARIANT is enabled")
if CHOICES.get("OUTSIDER_VARIANT") and not SAMPLE:
    raise ValueError("DATA.SAMPLE is required when OUTSIDER_VARIANT is enabled")
if INSIDER_SV_CALLER != "assemblytics":
    raise ValueError(
        f"INSIDER SV caller '{INSIDER_SV_CALLER}' is not implemented; "
        "available: assemblytics"
    )
if type(DETECT_ALL_TE) is not bool:
    raise ValueError("CHOICE.INSIDER_VARIANT.DETECT_ALL_TE must be a boolean")
if DETECT_ALL_TE and not CHOICES.get("INSIDER_VARIANT"):
    raise ValueError(
        "CHOICE.INSIDER_VARIANT.DETECT_ALL_TE requires "
        "CHOICE.PIPELINE.INSIDER_VARIANT"
    )


include: "rules/common.smk"
include: "rules/outsider.smk"
include: "rules/te_database.smk"
include: "rules/outsider_te.smk"
include: "rules/outsider_frequency.smk"
include: "rules/outsider_tsd.smk"
include: "rules/insider.smk"
include: "rules/insider_all_te.smk"
include: "rules/insider_frequency.smk"
include: "rules/insider_tsd.smk"
include: "rules/te_infos.smk"
include: "rules/report.smk"


DEFAULT_TARGETS = [
    f"{WORKDIR}/.inputs.prepared",
    f"{WORKDIR}/input_manifest.json",
    f"{WORKDIR}/INPUT/te_database.fasta",
    f"{WORKDIR}/INPUT/te_headers.tsv",
]
if CHOICES.get("INSIDER_VARIANT") or CHOICES.get("OUTSIDER_VARIANT"):
    DEFAULT_TARGETS.append(TE_INFOS)
if DETECT_ALL_TE:
    DEFAULT_TARGETS.append(INSIDER_ALL_TE_PUBLIC_BED)
if CHOICES.get("REPORT"):
    DEFAULT_TARGETS.append(REPORT_HTML)


rule all:
    input:
        DEFAULT_TARGETS,
